# Quick local preview: SQLite database stored in the Flask instance folder.
DATABASE_URL=sqlite:///campus_radio_manager.db

# Recommended MySQL setting for the final ECE-018 project (uncomment after
# creating the campus_radio_manager database and campus_app MySQL user):
# DATABASE_URL=mysql+pymysql://campus_app:YOUR_PASSWORD@127.0.0.1:3306/campus_radio_manager?charset=utf8mb4

SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
